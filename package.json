{
    "name": "lzh-blog",
    "title": "lzh Blog",
    "author": "lzh173",
    "version": "1.0.0",
    "private": true,
    "description": "初一八班电教委的个人博客，基于 Hux Blog 主题二次开发",
    "homepage": "https://blog.lzh173.chat",
    "repository": {
        "type": "git",
        "url": "https://github.com/lzh173/lzh173.github.io"
    },
    "bugs": "https://github.com/lzh173/lzh173.github.io/issues",
    "scripts": {
        "build": "npm run build:styles && npm run build:scripts",
        "build:styles": "node scripts/build-styles.mjs",
        "build:scripts": "node scripts/build-scripts.mjs",
        "build:jekyll": "bundle exec jekyll build",
        "watch": "node scripts/watch.mjs",
        "serve": "bundle exec jekyll serve --livereload",
        "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\""
    },
    "devDependencies": {
        "clean-css": "^5.3.3",
        "esbuild": "^0.28.2",
        "less": "^4.9.1"
    }
}
