# Cloudflare Pages 响应头（Netlify 风格语法）
# 参考: https://developers.cloudflare.com/pages/configuration/headers/
#
# 语法：路径规则单独一行，随后缩进的每一行是 "名称: 值"。
# 单条头也可以写成 "路径 名称: 值" 的紧凑形式。
#
# 注意：本文件以 _ 开头，Jekyll 只排除「以 _ 开头的目录」而不排除文件，
# 但仍需在 _config.yml 的 include: 里显式列出才会进入 _site/。

# ---- 全站安全头 ----
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# ---- 长期缓存：内容不变，且文件名与内容绑定 ----
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/pwa/icons/*
  Cache-Control: public, max-age=31536000, immutable
/pwa/manifest.json
  Cache-Control: public, max-age=86400

# ---- 图片：文件名不带内容哈希 ----
# 用一周但保留重新验证。若日后覆盖同名图片，最多一天内会被重新校验到。
/img/*
  Cache-Control: public, max-age=604800

# ---- 构建产物：文件名不带哈希 ----
# hux-blog.min.css / hux-blog.min.js 一旦被强缓存就很难更新，
# 因此必须每次回源校验。
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# ---- HTML 与数据文件：内容更新需立即生效 ----
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/feed.xml
  Cache-Control: public, max-age=0, must-revalidate
/search.json
  Cache-Control: public, max-age=0, must-revalidate

# ---- Service Worker 绝不能缓存，否则更新无法生效 ----
/sw.js
  Cache-Control: no-cache

# 说明：此处暂不设置 Content-Security-Policy。
# 页面含内联 <style>/<script>，且依赖百度统计与 Google AdSense。
# 上 CSP 需要 nonce/hash 体系，属独立工作。
